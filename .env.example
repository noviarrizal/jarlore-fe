# jarlore-be base URL (no trailing slash). Server-side only.
JARLORE_API_URL=http://localhost:8080

# Neon Auth (email one-time codes). Server-side only; leave empty to turn it off.
# Local development: use the `dev` branch's Auth URL, never production's.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=        # 32+ random characters: openssl rand -base64 32

# Development sign-in only: jarlore-be's local token issuer (go run ./cmd/devauth).
# Loopback URLs only; ignored in production builds. Leave empty to turn it off.
JARLORE_DEV_AUTH_URL=http://127.0.0.1:9999
